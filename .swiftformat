--swiftversion 6.0
--indent 4
--maxwidth 120
# Wrapped arguments align under the first one (paren-aligned). This must stay
# `after-first`: SwiftLint enforces the same shape via
# `vertical_parameter_alignment_on_call` + `collection_alignment`, and
# `before-first` would make the two tools demand opposite layouts.
--wraparguments after-first
--wrapparameters after-first
--wrapcollections after-first
--closingparen same-line
# SwiftFormat has no inheritance-clause equivalent of the options above: it will
# wrap a conformance list that exceeds --maxwidth, but it never unwraps one that
# fits. The `conformances_on_declaration_line` custom rule in .swiftlint.yml
# catches hand-wrapped lists that this formatter would leave alone.

# Spacing
--commas always
--semicolons never
--trimwhitespace always

# Braces
--allman false
--elseposition same-line
--guardelse same-line

# Imports
--importgrouping testable-first

# Misc
--self remove
--propertytypes inferred
--voidtype void
--stripunusedargs closure-only

# Rules — keep the project's characteristic style
--rules trailingCommas,redundantSelf,unusedArguments,blankLinesBetweenScopes,spaceAroundBraces,spaceAroundBrackets,spaceAroundComments,sortImports,wrapArguments

# Do not add //swiftformat:... comments automatically.
--disable fileHeader
